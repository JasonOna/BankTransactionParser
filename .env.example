# YNAB Configuration
YNAB_API_KEY=your_ynab_api_key_here
YNAB_BUDGET_ID=your_budget_id_here

# Bank/Card Account Mappings
# Maps CSV account names to YNAB account IDs
SAVINGS_ACCOUNT_ID=ynab_savings_account_id
CREDIT_CARD_ACCOUNT_ID=ynab_credit_card_account_id

# CSV File Paths
BANK_CSV_PATH=./data/bank_transactions.csv
CREDIT_CARD_CSV_PATH=./data/credit_card_transactions.csv

# Logging
LOG_LEVEL=info

# Optional: only import transactions from last N days
DAYS_BACK=30
